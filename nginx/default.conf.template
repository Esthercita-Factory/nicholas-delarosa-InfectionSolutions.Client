# ${API_UPSTREAM} lo reemplaza envsubst al arrancar el contenedor (por defecto http://api:8080).

# Esquema original del visitante. Este Nginx recibe http del Nginx del servidor, que es quien
# atiende el https: se reenvia el X-Forwarded-Proto que llega (o el propio, si no hay proxy
# delante). Sin esto la API le pasaria a Google/GitHub una URL de retorno http.
map $http_x_forwarded_proto $esquema_original {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # DNS interno de Docker: el nombre "api" se resuelve en cada peticion, asi Nginx
    # arranca aunque la API todavia no exista y sigue funcionando si se recrea.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # El Nginx del servidor reenvia en HTTP/1.0 y Nginx por defecto solo comprime HTTP/1.1:
    # sin gzip_http_version 1.0 el JavaScript llegaba sin comprimir (358 KiB en vez de ~90).
    gzip on;
    gzip_http_version 1.0;
    gzip_proxied any;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_types text/plain text/markdown text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # /api/... va a la API tal cual (proxy_pass con variable reenvia la URI original
    # completa). ^~ evita que la regla de archivos estaticos de abajo se quede con una
    # ruta de la API que termine en .svg o .png.
    location ^~ /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host conserva el puerto (localhost:8082): con $host la API armaria la URL de
        # retorno de Google/GitHub sin el puerto.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $esquema_original;
        proxy_read_timeout 60s;
        client_max_body_size 5m;
    }

    # Archivos con hash en el nombre (main-XXXX.js): se pueden cachear un año.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        try_files $uri =404;
    }

    # Cualquier otro archivo (robots.txt, llms.txt, /.well-known/...): si no existe es un 404
    # de verdad. Sin esto el fallback del SPA devolvia index.html con 200 y los rastreadores
    # lo leian como un robots.txt o un manifiesto invalido.
    location ~ \.[A-Za-z0-9]+$ {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        try_files $uri =404;
    }

    # /ingresar y /registro existen como HTML prerenderizado (ingresar/index.html); el
    # resto del portal (/catalogo, /compras/123) es la app sin prerender, index.csr.html.
    # Ningun HTML se cachea, para que un despliegue nuevo se vea de inmediato.
    location / {
        try_files $uri/index.html /index.csr.html;
        # add_header dentro de un location reemplaza los heredados: van todos aqui.
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
    }
}
